# Production-ready sample environment
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=tracking-websites.onrender.com
CORS_ORIGINS=https://tracking-websites.vercel.app
CSRF_TRUSTED_ORIGINS=https://tracking-websites.vercel.app
TRACKER_BASE_URL=https://tracking-websites.onrender.com
DB_ENGINE=sqlite
SQLITE_PATH=/tmp/db.sqlite3
# If you later use Postgres, switch DB_ENGINE=postgres and configure the values below:
DB_NAME=analytics_db
DB_USER=analytics_user
DB_PASSWORD=analytics_password
DB_HOST=postgres
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
